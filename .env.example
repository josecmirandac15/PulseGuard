# ===== PulseGuard environment =====
# Copy to .env and adjust. docker-compose reads this file automatically.

ENVIRONMENT=production
DEBUG=false

# --- PostgreSQL (docker-compose) ---
POSTGRES_DB=pulseguard
POSTGRES_USER=pulseguard
POSTGRES_PASSWORD=change_me_in_production

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- AI (optional; AI service falls back to rule-based report if empty) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b:free

# --- Webhook URLs (docker-compose sets the internal Docker DNS names) ---
HOSPITAL_WEBHOOK_URL=http://hospital-receiver:8001/webhook/hospital
INSURER_WEBHOOK_URL=http://insurer-receiver:8002/webhook/insurer

# --- Published host ports ---
# Point cloudflared at http://<PULSEGUARD_BIND>:<PULSEGUARD_HTTP_PORT>
PULSEGUARD_BIND=127.0.0.1
PULSEGUARD_HTTP_PORT=8080
PULSEGUARD_API_PORT=8000
